# cmake_uninstall.cmake.in — generated by CMake configure step
# Reads install_manifest.txt and removes every file that was installed.
# Run via:  cmake --build build --target uninstall

if(NOT EXISTS "@CMAKE_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR
    "Cannot find install manifest: @CMAKE_BINARY_DIR@/install_manifest.txt\n"
    "Have you run 'cmake --install' yet?")
endif()

file(READ "@CMAKE_BINARY_DIR@/install_manifest.txt" files)
string(REGEX REPLACE "\n" ";" files "${files}")
foreach(file ${files})
  set(abs_file "$ENV{DESTDIR}${file}")
  message(STATUS "Uninstalling: ${abs_file}")
  if(IS_SYMLINK "${abs_file}" OR EXISTS "${abs_file}")
    execute_process(
      COMMAND "@CMAKE_COMMAND@" -E remove "${abs_file}"
      OUTPUT_VARIABLE rm_out
      RESULT_VARIABLE rm_retval
    )
    if(NOT rm_retval EQUAL 0)
      message(SEND_ERROR "Problem removing ${abs_file}")
    endif()
  else()
    message(STATUS "File does not exist: ${abs_file}")
  endif()
endforeach()
