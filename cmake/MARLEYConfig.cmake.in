@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# MARLEY's exported targets name their public dependencies, so
# find_package(MARLEY) has to resolve them here. Without these calls the
# package hands back imported targets referring to HepMC3 and ROOT without
# either having been looked for, and the consumer fails at link time.
#
# GSL is absent on purpose, being a private dependency.
#
# Each call is gated on whether MARLEY exported an imported target for that
# dependency, not merely on whether it was available at build time. A
# vendored HepMC3 is carried by MARLEY::HepMC3_builtin and a
# root-config-discovered ROOT as raw flags; demanding the package in either
# case would fail for a consumer whose MARLEY built fine.
if(@MARLEY_NEEDS_HEPMC3_PACKAGE@)
  find_dependency(HepMC3)
endif()

if(@MARLEY_NEEDS_ROOT_PACKAGE@)
  find_dependency(ROOT COMPONENTS Core RIO Hist Tree)
endif()

# Import the exported targets (build-tree or install-tree). The calling
# find_package() will have located this file in either:
#  - <build>/<libdir>/cmake/MARLEY/   (build tree)
#  - <prefix>/<libdir>/cmake/MARLEY/  (install tree)
include("${CMAKE_CURRENT_LIST_DIR}/MARLEYTargets.cmake")

# There is deliberately no MARLEY_DATA_DIR variable. The data root is
# resolved at run time from the library's own location, and a consumer that
# baked a path into its build would defeat that. "marley info" reports the
# resolved value when a human needs to know.
