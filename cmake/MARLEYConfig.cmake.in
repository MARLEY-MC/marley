@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# MARLEY's exported targets name their public dependencies, so a consumer's
# find_package(MARLEY) has to be able to resolve them. These calls used to be
# commented out with the note "if you want to enforce dependency discovery",
# which meant the package handed back imported targets referring to HepMC3
# and ROOT without either having been looked for: find_package(MARLEY)
# appeared to succeed and the consumer failed later, at link time.
#
# GSL is absent on purpose. It is a private dependency -- used by
# src/marley_gsl.cc and named in no installed header -- so a consumer neither
# needs it nor should be made to find it.
#
# Each call is gated on whether MARLEY actually exported an imported target
# for that dependency, not merely on whether it was available at build time.
# A vendored HepMC3 is carried by MARLEY's own MARLEY::HepMC3_builtin target,
# and a root-config-discovered ROOT is carried as raw flags; in both cases
# demanding the package here would fail for a consumer whose MARLEY built
# perfectly well.
if(@MARLEY_NEEDS_HEPMC3_PACKAGE@)
  find_dependency(HepMC3)
endif()

if(@MARLEY_NEEDS_ROOT_PACKAGE@)
  find_dependency(ROOT COMPONENTS Core RIO Hist Tree)
endif()

# Import the exported targets (build-tree or install-tree). The calling
# find_package() will have located this file in either:
#  - <build>/<libdir>/cmake/MARLEY/   (build tree)
#  - <prefix>/<libdir>/cmake/MARLEY/  (install tree)
include("${CMAKE_CURRENT_LIST_DIR}/MARLEYTargets.cmake")

# There is deliberately no MARLEY_DATA_DIR variable here. The data root is
# resolved at run time from the library's own location, so a consumer that
# baked a path into its build would reintroduce exactly the non-relocatable
# coupling that removing marley-config --datadir was meant to eliminate.
# "marley info" reports the resolved value when a human needs to know.
